{
  "name": "ng-in-action",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "test": "ng test",
    "test:ci": "ng test --no-watch --coverage --coverage-reporters=json-summary --coverage-reporters=json",
    "test:cov": "ng test --no-watch --coverage && open-cli coverage/ng-in-action/index.html",
    "lint": "ng lint && stylelint \"**/*.scss\" && prettier --check .",
    "lint:fix": "ng lint --fix && stylelint \"**/*.scss\" --fix .src/**/*.scss && prettier --write .",
    "analyze": "ng build --stats-json --named-chunks && open-cli https://esbuild.github.io/analyze"
  },
  "lint-staged": {
    "**/*.{ts,html}": [
      "eslint --fix"
    ],
    "**/*.scss": [
      "stylelint --fix"
    ],
    "**/*.{ts,js,json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.17",
    "@angular/compiler": "^21.2.17",
    "@angular/core": "^21.2.17",
    "@angular/forms": "^21.2.17",
    "@angular/material": "^21.2.14",
    "@angular/platform-browser": "^21.2.17",
    "@angular/router": "^21.2.17",
    "@dicebear/core": "^10.3.0",
    "@dicebear/styles": "^10.2.0",
    "@microsoft/signalr": "^10.0.0",
    "@ngrx/store": "^21.1.1",
    "@ngrx/store-devtools": "^21.1.1",
    "dayjs": "^1.11.21",
    "lit": "^3.3.3",
    "lodash-es": "^4.18.1",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular-devkit/architect": "^0.2102.17",
    "@angular/build": "^21.2.17",
    "@angular/cli": "^21.2.17",
    "@angular/compiler-cli": "^21.2.17",
    "@angular/language-service": "^21.2.17",
    "@eslint/js": "^10.0.1",
    "@ngrx/eslint-plugin": "^21.1.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/lodash-es": "^4.17.12",
    "@vitest/coverage-v8": "^4.1.9",
    "@vitest/ui": "^4.1.9",
    "angular-eslint": "21.4.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.8",
    "open-cli": "^9.0.0",
    "prettier": "^3.9.4",
    "stylelint": "^17.14.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-scss": "^7.2.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.62.1",
    "vitest": "^4.1.9"
  }
}
